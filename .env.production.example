# =============================================================================
# ASISTEN+STOCK - PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# Salin berkas ini ke .env.production di server VPS:
#   cp .env.production.example .env.production
# =============================================================================

NODE_ENV=production

# --- Domain & Reverse Proxy ---
# Isi dengan domain atau subdomain kamu (contoh: stock.domainanda.com).
# Jika belum punya domain dan hanya pakai IP VPS, isi dengan IP (contoh: 103.150.x.x)
APP_DOMAIN=stock.domainanda.com

# --- Database PostgreSQL (Terisolasi di Jaringan Internal Docker) ---
POSTGRES_DB=asisten_stock_prod_db
POSTGRES_USER=asisten_prod_admin
# Ganti dengan password acak yang kuat (minimal 16 karakter acak):
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseYangSangatKuatDanAcak2026!

# --- Keamanan JWT Token ---
# Generate string acak 64 karakter (bisa pakai: openssl rand -hex 32)
JWT_SECRET=GantiDenganStringAcakMinimal64KarakterUntukKeamananTokenJwtUser

# --- CORS Origin ---
# Domain frontend yang diizinkan mengakses API:
CORS_ORIGIN=https://stock.domainanda.com

# --- AI & Telegram Integration ---
GEMINI_API_KEY=your_gemini_api_key_production_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot (Gunakan token dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_production_here
TELEGRAM_USE_POLLING=true
