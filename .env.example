# =============================================================================
# ASISTEN+STOCK - ENV TEMPLATE
# Salin file ini ke .env di root project, lalu sesuaikan nilainya:
#   npm run env:init
# =============================================================================

NODE_ENV=development

# --- Ports (host) ---
BACKEND_PORT=3050
FRONTEND_PORT=3051
POSTGRES_PORT=5450

# --- Host labels ---
APP_PUBLIC_HOST=localhost
FRONTEND_PUBLIC_HOST=localhost

# --- PostgreSQL ---
POSTGRES_DB=asisten_stock_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev

# --- Backend (local / be/.env) ---
PORT=3050
DATABASE_URL=postgresql://postgres:postgres_password_dev@localhost:5450/asisten_stock_db
CORS_ORIGIN=http://localhost:3051,http://localhost:3000
JSON_BODY_LIMIT=10mb
STARTUP_RETRIES=30
STARTUP_DELAY_MS=2000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
DB_WAIT_ATTEMPTS=30

# --- Backend (Docker internal — dipakai docker-compose) ---
DATABASE_URL_DOCKER=postgresql://postgres:postgres_password_dev@postgres:5432/asisten_stock_db

# --- AI & Bot Credentials ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-public-domain.com/api/telegram/webhook
TELEGRAM_USE_POLLING=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3050/api
INTERNAL_API_URL=http://backend:3050/api

# --- Docker service names ---
POSTGRES_CONTAINER_NAME=asisten-postgres
BACKEND_CONTAINER_NAME=asisten-backend
FRONTEND_CONTAINER_NAME=asisten-frontend
